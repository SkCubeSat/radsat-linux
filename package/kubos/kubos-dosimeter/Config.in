menuconfig BR2_PACKAGE_KUBOS_DOSIMETER
    bool "RADSAT Dosimeter Service"
    default n
    select BR2_PACKAGE_HAS_KUBOS_DOSIMETER
    help
        Include RADSAT Dosimeter Service as a Kubos service.

if BR2_PACKAGE_KUBOS_DOSIMETER

config BR2_KUBOS_DOSIMETER_INIT_LVL
    int "Service Run Level"
    default 90
    range 10 99
    depends on BR2_PACKAGE_KUBOS_DOSIMETER
    help
        The initialization priority level of the RADSAT Dosimeter Service.
        The lower the number, the earlier the service is initialized.

config BR2_KUBOS_DOSIMETER_RESTART_COUNT
    int "Service Restart Limit"
    default 3
    depends on BR2_PACKAGE_KUBOS_DOSIMETER
    depends on BR2_PACKAGE_MONIT
    help
        The maximum number of times the service should be restarted within the timeframe
        specified by BR2_KUBOS_DOSIMETER_RESTART_CYCLES if it goes down

config BR2_KUBOS_DOSIMETER_RESTART_CYCLES
    int "Service Restart Limit Timeframe"
    default 10
    depends on BR2_PACKAGE_KUBOS_DOSIMETER
    depends on BR2_PACKAGE_MONIT
    help
        The number of Monit monitoring cycles in which the maximum number of service restarts
        must occur before the system stops trying to recover the service.

        The resulting maximum timeframe in which the restarts must occur can be calculated by
        multiplying this number by the length of a single Monit sleep cycle (60 seconds)

config BR2_KUBOS_DOSIMETER_IP
    string "Service IP Address"
    default "0.0.0.0"
    depends on BR2_PACKAGE_KUBOS_DOSIMETER
    help
        The IP address which the service should use to receive GraphQL requests

config BR2_KUBOS_DOSIMETER_PORT
    int "Service Port"
    default 8093
    depends on BR2_PACKAGE_KUBOS_DOSIMETER
    help
        The port which the service should use to receive GraphQL requests

config BR2_KUBOS_DOSIMETER_I2C_BUS
    string "I2C Bus"
    default "/dev/i2c-1"
    depends on BR2_PACKAGE_KUBOS_DOSIMETER
    help
        Linux I2C bus connected to the dosimeter.

config BR2_KUBOS_DOSIMETER_DEVICE_ADDR
    hex "Device I2C Address"
    default 0x48
    depends on BR2_PACKAGE_KUBOS_DOSIMETER
    help
        Linux 7-bit I2C address for the dosimeter.

endif

config BR2_PACKAGE_HAS_KUBOS_DOSIMETER
    bool

config BR2_PACKAGE_PROVIDES_KUBOS_DOSIMETER
    string
    default "kubos"
