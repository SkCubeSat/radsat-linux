menuconfig BR2_PACKAGE_KUBOS_CUBE_ADCS
    bool "RADSAT Cube ADCS Service"
    default n
    select BR2_PACKAGE_HAS_KUBOS_CUBE_ADCS
    help
        Include RADSAT Cube ADCS Service as a Kubos service.

if BR2_PACKAGE_KUBOS_CUBE_ADCS

config BR2_KUBOS_CUBE_ADCS_INIT_LVL
    int "Service Run Level"
    default 90
    range 10 99
    depends on BR2_PACKAGE_KUBOS_CUBE_ADCS
    help
        The initialization priority level of the RADSAT Cube ADCS Service.
        The lower the number, the earlier the service is initialized.

config BR2_KUBOS_CUBE_ADCS_RESTART_COUNT
    int "Service Restart Limit"
    default 3
    depends on BR2_PACKAGE_KUBOS_CUBE_ADCS
    depends on BR2_PACKAGE_MONIT
    help
        The maximum number of times the service should be restarted within the timeframe
        specified by BR2_KUBOS_CUBE_ADCS_RESTART_CYCLES if it goes down

config BR2_KUBOS_CUBE_ADCS_RESTART_CYCLES
    int "Service Restart Limit Timeframe"
    default 10
    depends on BR2_PACKAGE_KUBOS_CUBE_ADCS
    depends on BR2_PACKAGE_MONIT
    help
        The number of Monit monitoring cycles in which the maximum number of service restarts
        must occur before the system stops trying to recover the service.

        The resulting maximum timeframe in which the restarts must occur can be calculated by
        multiplying this number by the length of a single Monit sleep cycle (60 seconds)

config BR2_KUBOS_CUBE_ADCS_IP
    string "Service IP Address"
    default "0.0.0.0"
    depends on BR2_PACKAGE_KUBOS_CUBE_ADCS
    help
        The IP address which the service should use to receive GraphQL requests

config BR2_KUBOS_CUBE_ADCS_PORT
    int "Service Port"
    default 8094
    depends on BR2_PACKAGE_KUBOS_CUBE_ADCS
    help
        The port which the service should use to receive GraphQL requests

config BR2_KUBOS_CUBE_ADCS_CAN_INTERFACE
    string "CAN Interface"
    default "can0"
    depends on BR2_PACKAGE_KUBOS_CUBE_ADCS
    help
        Linux SocketCAN interface connected to the CubeSpace ADCS.

config BR2_KUBOS_CUBE_ADCS_CAN_BITRATE
    int "CAN Bitrate"
    default 1000000
    depends on BR2_PACKAGE_KUBOS_CUBE_ADCS
    help
        CAN bus bitrate.

config BR2_KUBOS_CUBE_ADCS_SOURCE_ADDRESS
    int "Source Address"
    default 1
    depends on BR2_PACKAGE_KUBOS_CUBE_ADCS
    help
        CubeSpace source address used by the OBC.

config BR2_KUBOS_CUBE_ADCS_DESTINATION_ADDRESS
    int "Destination Address"
    default 4
    depends on BR2_PACKAGE_KUBOS_CUBE_ADCS
    help
        CubeSpace destination address used by the ADCS.

config BR2_KUBOS_CUBE_ADCS_TIMEOUT_MS
    int "Timeout Milliseconds"
    default 5000
    depends on BR2_PACKAGE_KUBOS_CUBE_ADCS
    help
        Request/response timeout in milliseconds.

endif

config BR2_PACKAGE_HAS_KUBOS_CUBE_ADCS
    bool

config BR2_PACKAGE_PROVIDES_KUBOS_CUBE_ADCS
    string
    default "kubos"
