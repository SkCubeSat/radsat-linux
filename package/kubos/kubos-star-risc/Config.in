menuconfig BR2_PACKAGE_KUBOS_STAR_RISC
    bool "RADSAT Star RISC Service"
    default n
    select BR2_PACKAGE_HAS_KUBOS_STAR_RISC
    help
        Include RADSAT Star RISC Service as a Kubos service.

if BR2_PACKAGE_KUBOS_STAR_RISC

config BR2_KUBOS_STAR_RISC_INIT_LVL
    int "Service Run Level"
    default 90
    range 10 99
    depends on BR2_PACKAGE_KUBOS_STAR_RISC
    help
        The initialization priority level of the RADSAT Star RISC Service.
        The lower the number, the earlier the service is initialized.

config BR2_KUBOS_STAR_RISC_RESTART_COUNT
    int "Service Restart Limit"
    default 3
    depends on BR2_PACKAGE_KUBOS_STAR_RISC
    depends on BR2_PACKAGE_MONIT
    help
        The maximum number of times the service should be restarted within the timeframe
        specified by BR2_KUBOS_STAR_RISC_RESTART_CYCLES if it goes down

config BR2_KUBOS_STAR_RISC_RESTART_CYCLES
    int "Service Restart Limit Timeframe"
    default 10
    depends on BR2_PACKAGE_KUBOS_STAR_RISC
    depends on BR2_PACKAGE_MONIT
    help
        The number of Monit monitoring cycles in which the maximum number of service restarts
        must occur before the system stops trying to recover the service.

        The resulting maximum timeframe in which the restarts must occur can be calculated by
        multiplying this number by the length of a single Monit sleep cycle (60 seconds)

config BR2_KUBOS_STAR_RISC_IP
    string "Service IP Address"
    default "0.0.0.0"
    depends on BR2_PACKAGE_KUBOS_STAR_RISC
    help
        The IP address which the service should use to receive GraphQL requests

config BR2_KUBOS_STAR_RISC_PORT
    int "Service Port"
    default 8001
    depends on BR2_PACKAGE_KUBOS_STAR_RISC
    help
        The port which the service should use to receive GraphQL requests

config BR2_KUBOS_STAR_RISC_UART_BUS
    string "UART Bus"
    default "TBD"
    depends on BR2_PACKAGE_KUBOS_STAR_RISC
    help
        Linux UART connected to the Star RISC payload. Wiring is TBD.

config BR2_KUBOS_STAR_RISC_UART_BAUD
    int "UART Baud"
    default 115200
    depends on BR2_PACKAGE_KUBOS_STAR_RISC
    help
        UART baud rate for the Star RISC payload.

endif

config BR2_PACKAGE_HAS_KUBOS_STAR_RISC
    bool

config BR2_PACKAGE_PROVIDES_KUBOS_STAR_RISC
    string
    default "kubos"
