menuconfig BR2_PACKAGE_KUBOS_SNN
    bool "RADSAT SNN Service"
    default n
    select BR2_PACKAGE_HAS_KUBOS_SNN
    help
        Include RADSAT SNN Service as a Kubos service.

if BR2_PACKAGE_KUBOS_SNN

config BR2_KUBOS_SNN_INIT_LVL
    int "Service Run Level"
    default 90
    range 10 99
    depends on BR2_PACKAGE_KUBOS_SNN
    help
        The initialization priority level of the RADSAT SNN Service.
        The lower the number, the earlier the service is initialized.

config BR2_KUBOS_SNN_RESTART_COUNT
    int "Service Restart Limit"
    default 3
    depends on BR2_PACKAGE_KUBOS_SNN
    depends on BR2_PACKAGE_MONIT
    help
        The maximum number of times the service should be restarted within the timeframe
        specified by BR2_KUBOS_SNN_RESTART_CYCLES if it goes down

config BR2_KUBOS_SNN_RESTART_CYCLES
    int "Service Restart Limit Timeframe"
    default 10
    depends on BR2_PACKAGE_KUBOS_SNN
    depends on BR2_PACKAGE_MONIT
    help
        The number of Monit monitoring cycles in which the maximum number of service restarts
        must occur before the system stops trying to recover the service.

        The resulting maximum timeframe in which the restarts must occur can be calculated by
        multiplying this number by the length of a single Monit sleep cycle (60 seconds)

config BR2_KUBOS_SNN_IP
    string "Service IP Address"
    default "0.0.0.0"
    depends on BR2_PACKAGE_KUBOS_SNN
    help
        The IP address which the service should use to receive GraphQL requests

config BR2_KUBOS_SNN_PORT
    int "Service Port"
    default 8092
    depends on BR2_PACKAGE_KUBOS_SNN
    help
        The port which the service should use to receive GraphQL requests

config BR2_KUBOS_SNN_UART_BUS
    string "UART Bus"
    default "/dev/ttyS4"
    depends on BR2_PACKAGE_KUBOS_SNN
    help
        Linux UART connected to the SNN payload board. Wiring is TBD.

endif

config BR2_PACKAGE_HAS_KUBOS_SNN
    bool

config BR2_PACKAGE_PROVIDES_KUBOS_SNN
    string
    default "kubos"
