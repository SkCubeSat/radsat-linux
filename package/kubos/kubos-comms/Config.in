menuconfig BR2_PACKAGE_KUBOS_COMMS
    bool "RADSAT NXTRX4 Communications Service"
    default n
    select BR2_PACKAGE_HAS_KUBOS_COMMS
    help
        Include RADSAT NXTRX4 Communications Service as a Kubos service.

if BR2_PACKAGE_KUBOS_COMMS

config BR2_KUBOS_COMMS_INIT_LVL
    int "Service Run Level"
    default 95
    range 10 99
    depends on BR2_PACKAGE_KUBOS_COMMS
    help
        The initialization priority level of the RADSAT NXTRX4 Communications Service.
        The lower the number, the earlier the service is initialized.

config BR2_KUBOS_COMMS_RESTART_COUNT
    int "Service Restart Limit"
    default 3
    depends on BR2_PACKAGE_KUBOS_COMMS
    depends on BR2_PACKAGE_MONIT
    help
        The maximum number of times the service should be restarted within the timeframe
        specified by BR2_KUBOS_COMMS_RESTART_CYCLES if it goes down

config BR2_KUBOS_COMMS_RESTART_CYCLES
    int "Service Restart Limit Timeframe"
    default 10
    depends on BR2_PACKAGE_KUBOS_COMMS
    depends on BR2_PACKAGE_MONIT
    help
        The number of Monit monitoring cycles in which the maximum number of service restarts
        must occur before the system stops trying to recover the service.

        The resulting maximum timeframe in which the restarts must occur can be calculated by
        multiplying this number by the length of a single Monit sleep cycle (60 seconds)

config BR2_KUBOS_COMMS_PORT
    int "Service Port"
    default 8150
    depends on BR2_PACKAGE_KUBOS_COMMS
    help
        The port which the service should use to receive GraphQL requests

endif

config BR2_PACKAGE_HAS_KUBOS_COMMS
    bool

config BR2_PACKAGE_PROVIDES_KUBOS_COMMS
    string
    default "kubos"
