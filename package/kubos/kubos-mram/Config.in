menuconfig BR2_PACKAGE_KUBOS_MRAM
    bool "RADSAT MRAM Service"
    default n
    select BR2_PACKAGE_HAS_KUBOS_MRAM
    help
        Include RADSAT MRAM Service as a Kubos service.

if BR2_PACKAGE_KUBOS_MRAM

config BR2_KUBOS_MRAM_INIT_LVL
    int "Service Run Level"
    default 90
    range 10 99
    depends on BR2_PACKAGE_KUBOS_MRAM
    help
        The initialization priority level of the RADSAT MRAM Service.
        The lower the number, the earlier the service is initialized.

config BR2_KUBOS_MRAM_RESTART_COUNT
    int "Service Restart Limit"
    default 3
    depends on BR2_PACKAGE_KUBOS_MRAM
    depends on BR2_PACKAGE_MONIT
    help
        The maximum number of times the service should be restarted within the timeframe
        specified by BR2_KUBOS_MRAM_RESTART_CYCLES if it goes down

config BR2_KUBOS_MRAM_RESTART_CYCLES
    int "Service Restart Limit Timeframe"
    default 10
    depends on BR2_PACKAGE_KUBOS_MRAM
    depends on BR2_PACKAGE_MONIT
    help
        The number of Monit monitoring cycles in which the maximum number of service restarts
        must occur before the system stops trying to recover the service.

        The resulting maximum timeframe in which the restarts must occur can be calculated by
        multiplying this number by the length of a single Monit sleep cycle (60 seconds)

config BR2_KUBOS_MRAM_IP
    string "Service IP Address"
    default "0.0.0.0"
    depends on BR2_PACKAGE_KUBOS_MRAM
    help
        The IP address which the service should use to receive GraphQL requests

config BR2_KUBOS_MRAM_PORT
    int "Service Port"
    default 8090
    depends on BR2_PACKAGE_KUBOS_MRAM
    help
        The port which the service should use to receive GraphQL requests

config BR2_KUBOS_MRAM_SPI_DEVICE
    string "SPI Device"
    default "/dev/spidev1.0"
    depends on BR2_PACKAGE_KUBOS_MRAM
    help
        Linux spidev device connected to the MRAM.

config BR2_KUBOS_MRAM_SPI_SPEED_HZ
    int "SPI Speed (Hz)"
    default 10000000
    depends on BR2_PACKAGE_KUBOS_MRAM
    help
        SPI clock speed for the MRAM device.

config BR2_KUBOS_MRAM_SPI_MODE
    int "SPI Mode"
    default 0
    depends on BR2_PACKAGE_KUBOS_MRAM
    help
        SPI mode for the MRAM device.

endif

config BR2_PACKAGE_HAS_KUBOS_MRAM
    bool

config BR2_PACKAGE_PROVIDES_KUBOS_MRAM
    string
    default "kubos"
