From 4a5b8c8a4ebf6d658d4055ac38eb724193b05091 Mon Sep 17 00:00:00 2001
From: RADSAT Build System <software@skcubed.org>
Date: Sun, 8 Jun 2026 21:54:00 -0600
Subject: [PATCH] Relax build-system requirements

Buildroot 2025.02 provides poetry-core 2 and a newer setuptools. The
package is pure Python and builds correctly with those versions, so do
not reject the current Buildroot host tooling.

Upstream: Not applicable [Buildroot-specific]
Signed-off-by: RADSAT Build System <software@skcubed.org>
---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index 6a5434c..c87cb65 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -68,4 +68,4 @@ target-version = ['py36', 'py37', 'py38', 'py39', 'py310']
 
 [build-system]
-requires = ["poetry_core>=1,<2", "setuptools>=59,<70"]
+requires = ["poetry_core>=1,<3", "setuptools>=59"]
 build-backend = "poetry.core.masonry.api"
