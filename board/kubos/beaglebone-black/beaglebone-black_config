CONFIG_ARM=y
CONFIG_TARGET_BEAGLEBONE_BLACK=y
# CONFIG_SPL_NAND_SUPPORT is not set
CONFIG_SPL_STACK_R_ADDR=0x82000000
CONFIG_FIT=y
CONFIG_FIT_VERBOSE=y
CONFIG_SPL=y
CONFIG_SPL_STACK_R=y
# No USB in SPL — flight board has no USB connector
# CONFIG_SPL_MUSB_NEW_SUPPORT is not set
CONFIG_HUSH_PARSER=y
CONFIG_BOOTDELAY=2
CONFIG_SYS_PROMPT="U-Boot> "
CONFIG_CMD_BOOTZ=y
# CONFIG_CMD_IMLS is not set
# CONFIG_CMD_ELF is not set
# CONFIG_CMD_IMI is not set
CONFIG_CMD_MEMINFO=y
# CONFIG_CMD_LOADS is not set
CONFIG_CMD_ASKENV=y
# CONFIG_CMD_FLASH is not set
CONFIG_CMD_MMC=y
CONFIG_CMD_SPI=y
CONFIG_CMD_I2C=y
# CONFIG_CMD_USB is not set
# CONFIG_CMD_DFU is not set
# CONFIG_CMD_FPGA is not set
CONFIG_CMD_GPIO=y
# CONFIG_CMD_SOURCE is not set
# CONFIG_CMD_SETEXPR is not set
# No Ethernet commands — no PHY/connector on flight board
# CONFIG_CMD_DHCP is not set
# CONFIG_CMD_MII is not set
# CONFIG_CMD_PING is not set
# CONFIG_CMD_NET is not set
# CONFIG_CMD_NFS is not set
# CONFIG_NET is not set
CONFIG_CMD_EXT2=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_EXT4_WRITE=y
CONFIG_CMD_FAT=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_FITUPD=y
CONFIG_UPDATE_KUBOS=y
# DFU/USB gadget unused without USB connector
# CONFIG_DFU is not set
# CONFIG_DFU_TFTP is not set
# CONFIG_DFU_MMC is not set
CONFIG_SYS_NS16550=y
# CONFIG_USB is not set
# CONFIG_USB_MUSB_HOST is not set
# CONFIG_USB_MUSB_GADGET is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_GADGET is not set
# CONFIG_USB_GADGET_DOWNLOAD is not set
CONFIG_OF_LIBFDT=y
CONFIG_FIT_SIGNATURE=y
