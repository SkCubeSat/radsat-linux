/dts-v1/;

#include "am33xx-boneblack.dtsi"
#include <dt-bindings/i2c/i2c.h>

/ {
	model = "Beaglebone Black";
	compatible = "kubos,bbb", "ti,am335x-bone-black", "ti,am335x-bone", "ti,am33xx";
};

&am33xx_pinmux {
	/*
	 * am335x-bone-common.dtsi already hogs clkout2_pin. Setting
	 * pinctrl-0 here replaces that property, so clkout2 stays listed.
	 * There is no gpio-of-helper driver in this kernel.
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&clkout2_pin &satellite_gpio_pins>;

	/* Satellite Mission GPIO Configuration */
	satellite_gpio_pins: pinmux_satellite_gpio_pins {
		pinctrl-single,pins = <
			/* GPIO 1: P9.25 (MCASP0_AHCLKX -> gpio3_21) - VHF Serial In, Output, PDR */
			0x1ac (PIN_OUTPUT_PULLDOWN | MUX_MODE7)

			/* GPIO 2: P8.7  (GPMC_ADVN_ALE -> gpio2_2)  - VHF Serial Out, Input, PUR */
			0x090 (PIN_INPUT_PULLUP    | MUX_MODE7)

			/* GPIO 3: P9.27 (MCASP0_FSR    -> gpio3_19) - UHF Serial In, Output, PDR */
			0x1a4 (PIN_OUTPUT_PULLDOWN | MUX_MODE7)

			/* GPIO 4: P9.42 Ball C18 (ECAP0        -> gpio0_7)  - UHF Serial Out, Input, PUR */
			0x164 (PIN_INPUT_PULLUP    | MUX_MODE7)

			/* GPIO 4: P9.42 Ball B12 (MCASP0_ACLKR -> gpio3_18) - UHF Serial Out, Input, PUR */
			0x1a0 (PIN_INPUT_PULLUP    | MUX_MODE7)

			/* GPIO 5: P8.10 (GPMC_WEN      -> gpio2_4)  - +X Solar Panel Serial Out, Input, PUR */
			0x098 (PIN_INPUT_PULLUP    | MUX_MODE7)

			/* GPIO 6: P8.9  (GPMC_BEN0_CLE -> gpio2_5)  - -X Solar Panel Serial Out, Input, PUR */
			0x094 (PIN_INPUT_PULLUP    | MUX_MODE7)

			/* GPIO 7: P8.16 (GPMC_AD14     -> gpio1_14) - GNSS Enable, Output, PUR */
			0x038 (PIN_OUTPUT_PULLUP   | MUX_MODE7)

			/* GPIO 8: P8.26 (GPMC_CSN0     -> gpio1_29) - SNN Enable, Output, PDR */
			0x07c (PIN_OUTPUT_PULLDOWN | MUX_MODE7)

			/* GPIO 9: P8.8  (GPMC_OEN_REN  -> gpio2_3)  - CNN Boot, Output, PUR */
			0x08c (PIN_OUTPUT_PULLUP   | MUX_MODE7)

			/* GPIO 10: P9.12 (GPMC_BEN1 -> gpio1_28) - GNSS Reset, Output, PUR */
			0x078 (PIN_OUTPUT_PULLUP   | MUX_MODE7)

			/* GPIO 11: P9.15 (GPMC_A0 -> gpio1_16) - SNN Reset, Output, PDR */
			0x040 (PIN_OUTPUT_PULLDOWN | MUX_MODE7)

			/* ADCS Enable: P8.15 (GPMC_AD15 -> gpio1_15) - ADCS Enable Control, Output, PUR */
			0x03c (PIN_OUTPUT_PULLUP   | MUX_MODE7)
		>;
	};

	uart1_pins: pinmux_uart1_pins {
		pinctrl-single,pins = <
			0x184 (PIN_OUTPUT | MUX_MODE0)	/* TX  - P9.24 */
			0x180 (PIN_INPUT  | MUX_MODE0)	/* RX  - P9.26 */
			/* RTS/CTS conflicts with I2C2 */
		>;
	};

	uart2_pins: pinmux_uart2_pins {
		pinctrl-single,pins = <
			0x154 (PIN_OUTPUT | MUX_MODE1)	/* TX  - P9.21 */
			0x150 (PIN_INPUT  | MUX_MODE1)	/* RX  - P9.22 */
		>;
	};

	uart3_pins: pinmux_uart3_pins {
		pinctrl-single,pins = <
			0x164 (PIN_OUTPUT | MUX_MODE1)	/* TX  - P9.42 */
			0x0cc (PIN_OUTPUT | MUX_MODE6)	/* RTS - P8.34 */
			0x0c8 (PIN_INPUT  | MUX_MODE6)	/* CTS - P8.36 */
		>;
	};

	uart4_pins: pinmux_uart4_pins {
		pinctrl-single,pins = <
			0x074 (PIN_OUTPUT | MUX_MODE6)	/* TX  - P9.13 */
			0x070 (PIN_INPUT  | MUX_MODE6)	/* RX  - P9.11 */
			0x0d4 (PIN_OUTPUT | MUX_MODE6)	/* RTS - P8.33 */
			0x0d0 (PIN_INPUT  | MUX_MODE6)	/* CTS - P8.35 */
		>;
	};

	uart5_pins: pinmux_uart5_pins {
		pinctrl-single,pins = <
			0x0c0 (PIN_OUTPUT | MUX_MODE4)	/* TX  - P8.37 */
			0x0c4 (PIN_INPUT  | MUX_MODE4)	/* RX  - P8.38 */
			0x0dc (PIN_OUTPUT | MUX_MODE6)	/* RTS - P8.32 */
			0x0d8 (PIN_INPUT  | MUX_MODE6)	/* CTS - P8.31 */
		>;
	};

	i2c1_pins: pinmux_i2c1_pins {
		pinctrl-single,pins = <
			0x158 (PIN_INPUT_PULLUP | MUX_MODE2)	/* SDA - P9.18 */
			0x15c (PIN_INPUT_PULLUP | MUX_MODE2)	/* SCL - P9.17 */
		>;
	};

	spi1_pins: pinmux_spi1_pins {
		pinctrl-single,pins = <
			0x190 (PIN_INPUT_PULLUP  | MUX_MODE3)	/* SCLK - P9.31 */
			0x194 (PIN_INPUT_PULLUP  | MUX_MODE3)	/* MISO - P9.29 */
			0x198 (PIN_OUTPUT_PULLUP | MUX_MODE3)	/* MOSI - P9.30 */
			0x19c (PIN_OUTPUT_PULLUP | MUX_MODE3)	/* CS0  - P9.28 */
		>;
	};

	dcan0_pins_default: dcan0_pins_default {
		pinctrl-single,pins = <
			AM33XX_IOPAD(0x920, PIN_INPUT_PULLUP  | MUX_MODE1) /* MII1_TXD2 -> dcan0_rx */
			AM33XX_IOPAD(0x91c, PIN_OUTPUT_PULLUP | MUX_MODE1) /* MII1_TXD3 -> dcan0_tx */
		>;
	};

	dcan0_clk: dcan0_clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock_frequency = <24000000>;
	};
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
	clock-frequency = <100000>;
	status = "okay";
};

&i2c2 {
	status = "okay";

	/* OBC own address 0x09. The radios master-write frames here. */
	frameq@40000009 {
		compatible = "slave-frameq";
		reg = <(I2C_OWN_SLAVE_ADDRESS | 0x09)>;
	};

	rv3028: rtc@52 {
		compatible = "microcrystal,rv3028";
		reg = <0x52>;
	};
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins>;
	status = "okay";
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2_pins>;
	status = "okay";
};

&uart3 {
	/* Pad 0x164 is P9.42 and is hogged as the UHF serial GPIO. */
	status = "disabled";
};

&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart4_pins>;
	status = "okay";
};

&uart5 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart5_pins>;
	status = "okay";
};

&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_pins>;
	ti,spi-num-cs = <1>;
	/* gpio0_7 is P9.42 ball C18, claimed by the satellite GPIO hog. */
	cs-gpios = <&gpio3 17 0>;

	status = "okay";

	spidev@0 {
		spi-max-frequency = <24000000>;
		reg = <0>;
		compatible = "spidev";
	};
};

&tscadc {
	status = "okay";
	adc {
		ti,adc-channels = <0 1 2 3 4 5 6>;
		ti,chan-step-avg = <0x16 0x16 0x16 0x16 0x16 0x16 0x16>;
		ti,chan-step-opendelay = <0x98 0x98 0x98 0x98 0x98 0x98 0x98>;
		ti,chan-step-sampledelay = <0x0 0x0 0x0 0x0 0x0 0x0 0x0>;
	};
};

&dcan0 {
	compatible = "ti,am3352-d_can", "bosch,d_can";
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&dcan0_pins_default>;
};

/* Disable CPSW Ethernet */
&mac {
	status = "disabled";
};

&cpsw_emac0 {
	status = "disabled";
};

&cpsw_emac1 {
	status = "disabled";
};

/* Disable McASP audio to release Ball B12 (0x1a0) on P9.42 */
&mcasp0 {
	status = "disabled";
};
