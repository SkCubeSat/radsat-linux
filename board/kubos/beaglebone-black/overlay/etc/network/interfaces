auto lo
iface lo inet loopback

# No eth0 — flight board has no Ethernet PHY/connector.
# No can1 — only one CAN bus on this build.

# SLIP over UART (ttyS5) for serial IP when needed
auto sl0
iface sl0 inet static
        address 192.168.0.2
        netmask 255.255.255.0
        pointopoint 192.168.0.1
        pre-up slattach -s 115200 -p cslip /dev/ttyS5 &
        post-up route add 192.168.0.2 dev lo

auto can0
iface can0 inet manual
    pre-up /sbin/ip link set $IFACE down
    up /sbin/ip link set $IFACE up type can bitrate 1000000
    down /sbin/ip link set $IFACE down
