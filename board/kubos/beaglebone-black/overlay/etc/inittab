#
# Note: BusyBox init doesn't support runlevels.  The runlevels field is
# completely ignored by BusyBox init. If you want runlevels, use
# sysvinit.
#
# Format for each entry: <id>:<runlevels>:<action>:<process>
#
# id        == tty to run on, or empty for /dev/console
# runlevels == ignored
# action    == one of sysinit, respawn, askfirst, wait, and once
# process   == program to run

# Startup the system
::sysinit:/bin/mount -t proc proc /proc
# Hide KERN_NOTICE+ on console (e.g. "random: nonblocking pool is initialized")
::sysinit:/bin/sh -c 'echo 5 >/proc/sys/kernel/printk'
::sysinit:/bin/mkdir -p /dev/pts
::sysinit:/bin/mkdir -p /dev/shm
# Check & clean partitions
::sysinit:/sbin/fsck -p /dev/mmcblk0p1
::sysinit:/sbin/fsck -p /dev/mmcblk0p2
::sysinit:/sbin/fsck -p /dev/mmcblk1p2
::sysinit:/sbin/fsck -p /dev/mmcblk1p3
::sysinit:/sbin/fsck -p /dev/mmcblk1p4
# Check & clean partitions in no-SD-card case
::sysinit:/sbin/fsck -p /dev/mmcblk0p3
::sysinit:/sbin/fsck -p /dev/mmcblk0p4
# Mount up partitions with data
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mount -a
# Create /run/lock for fw_printenv/fw_setenv lock file (/var/lock -> ../run/lock)
::sysinit:/bin/mkdir -p /run/lock
::sysinit:/bin/chmod 1777 /run/lock
# Mount Kubos volumes. /home and /envar live on the main SD image.
# /upgrade and /home/microsd come from aux-sd.img (disk 41555820) and
# are optional when only kubos-linux.img is flashed.
::sysinit:/bin/mount /home
::sysinit:/bin/sh -c 'mount /home/microsd 2>/dev/null || true'
::sysinit:/bin/sh -c 'mount /upgrade 2>/dev/null || true'
::sysinit:/bin/mount /envar
# Setup hostname
::sysinit:/bin/hostname -F /etc/hostname
# now run any rc scripts
::sysinit:/etc/init.d/rcS
# Run Monit via helper so reboot can stop respawns (see /sbin/monit-respawn).
::respawn:/sbin/monit-respawn

# Put a getty on the serial port
ttyS0::respawn:/sbin/getty -L  ttyS0 115200 vt100 # GENERIC_SERIAL

# Stuff to do for the 3-finger salute
#::ctrlaltdel:/sbin/reboot

# Stuff to do before rebooting. One bounded script: rcK or umount
# must not be able to sit forever and skip the reboot syscall.
::shutdown:/sbin/flush-filesystems
