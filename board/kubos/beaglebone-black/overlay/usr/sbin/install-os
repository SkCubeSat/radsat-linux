# Install / mirror Kubos images between SD and eMMC, and create raw
# backup image copies in unused SD space when capacity allows.
#
# Usage:
#   install-os                         # interactive menu
#   install-os sd-to-emmc [-y]
#   install-os emmc-to-sd [-y] [--backups]
#   install-os sd-backups [-y]         # clone SD primary into free SD space
#   install-os auto-recover [-y]       # power-loss-safe SD->eMMC for FRAM latch
#   install-os status
#
# SD backups are whole-image clones at sector offsets N * image_span.
# Slot 0 is the live primary (MBR + partitions). Slots 1..K live in
# unused space after the primary span and are for restore/recovery.
#
# Power-loss safety (sd-to-emmc / auto-recover):
#   1) Latch FRAM emmc_recovery_needed=true BEFORE writing eMMC
#   2) Copy SD -> eMMC in chunks; after each chunk set emmc_restore_offset
#   3) sync + verify eMMC has a bootable FAT kernel
#   4) Clear emmc_recovery_needed, emmc_restore_offset=0, boot_media=0
# A cut mid-copy leaves the latch set and a non-zero offset so the next
# boot resumes (U-Boot chunked restore or install-os auto-recover).
#

# NEVER use `set -e` with BusyBox ash on this image. Several common
# patterns (while-read EOF, failed globs, arithmetic edge cases) abort
# the script with zero output. Check failures explicitly instead.
set +e

# Pure-shell basename — do not rely on the BusyBox applet being enabled.
basename() {
    _b=$1
    _b=${_b%/}
    [ -n "$_b" ] || { echo "/"; return 0; }
    echo "${_b##*/}"
}

YES=0
DO_BACKUPS=0
MODE=""

usage() {
    cat <<'EOF'
Usage: install-os [command] [options]

Commands:
  sd-to-emmc     Copy SD primary image span onto eMMC (default)
  emmc-to-sd     Copy eMMC image span onto SD primary
  sd-backups     Create raw backup copies of the SD primary in free SD space
  auto-recover   Power-loss-safe SD->eMMC used when FRAM recovery is latched
  status         Show media sizes, image span, and possible SD backup slots
  (none)         Interactive menu

Options:
  -y, --yes      Skip confirmation
  --backups      With emmc-to-sd, also fill free SD space with backup copies
  -h, --help     Show this help
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        sd-to-emmc|emmc-to-sd|sd-backups|auto-recover|status)
            MODE=$1
            ;;
        -y|--yes)
            YES=1
            ;;
        --backups)
            DO_BACKUPS=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "install-os: unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

# Prefer id(1); fall back to /proc. Do not use `while read` under `set -e` —
# BusyBox ash treats EOF from read as failure and silently aborts the script.
euid=$(id -u 2>/dev/null) || euid=$(awk '/^Uid:/{print $3; exit}' /proc/self/status)
if [ -z "$euid" ] || [ "$euid" != "0" ]; then
    echo "install-os: must be root" >&2
    exit 1
fi

# Resolve SD vs eMMC by sysfs type, not by assuming mmcblk0/1 order.
SD=""
EMMC=""
for dev in /sys/block/mmcblk*; do
    [ -d "$dev" ] || continue
    name=$(basename "$dev")
    case "$name" in
        mmcblk*boot*|mmcblk*rpmb*) continue ;;
    esac
    typ=$(cat "$dev/device/type" 2>/dev/null) || continue
    if [ "$typ" = "SD" ] && [ -z "$SD" ]; then
        SD="/dev/$name"
    elif [ "$typ" = "MMC" ] && [ -z "$EMMC" ]; then
        EMMC="/dev/$name"
    fi
done

need_both() {
    if [ -z "$SD" ] || [ -z "$EMMC" ]; then
        echo "install-os: need one SD and one eMMC (found SD='$SD' eMMC='$EMMC')" >&2
        exit 1
    fi
}

need_sd() {
    if [ -z "$SD" ] || [ ! -b "$SD" ]; then
        echo "install-os: need an SD card" >&2
        exit 1
    fi
}

image_span_sectors() {
    # End of last partition on $1 (sysfs block name), in 512-byte sectors.
    _disk=$1
    _end=0
    for _p in /sys/block/${_disk}/${_disk}p*; do
        [ -d "$_p" ] || continue
        _start=$(cat "$_p/start")
        _size=$(cat "$_p/size")
        _part_end=$((_start + _size))
        if [ "$_part_end" -gt "$_end" ]; then
            _end=$_part_end
        fi
    done
    echo "$_end"
}

# MBR disk signature at offset 440 as little-endian 8 hex digits (PARTUUID prefix).
mbr_sig_le() {
    _raw=$(dd if="$1" bs=1 skip=440 count=4 2>/dev/null | hexdump -v -e '1/1 "%02x"')
    echo "$_raw" | sed -n 's/^\(..\)\(..\)\(..\)\(..\)$/\4\3\2\1/p'
}

root_disk_name() {
    _src=$(awk '$2 == "/" { print $1; exit }' /proc/mounts 2>/dev/null)
    [ -n "$_src" ] || _src=$(mount 2>/dev/null | awk '$3 == "/" { print $1; exit }')
    _name=$(basename "$_src")
    case "$_name" in
        mmcblk*p*)
            echo "${_name%%p*}"
            return 0
            ;;
        mmcblk*)
            echo "$_name"
            return 0
            ;;
    esac

    # BusyBox often mounts PARTUUID=... as /dev/root — resolve via cmdline + MBR sig.
    _partuuid=""
    if [ -r /proc/cmdline ]; then
        _partuuid=$(sed -n 's/.*root=PARTUUID=\([^ ]*\).*/\1/p' /proc/cmdline)
    fi
    if [ -z "$_partuuid" ]; then
        echo ""
        return 0
    fi
    _sig=$(echo "$_partuuid" | sed 's/-.*//' | tr 'A-F' 'a-f')
    _part=${_partuuid#*-}
    for _b in /sys/block/mmcblk*; do
        [ -d "$_b" ] || continue
        _d=$(basename "$_b")
        case "$_d" in
            *boot*|*rpmb*) continue ;;
        esac
        _raw=$(mbr_sig_le "/dev/$_d")
        [ "$_raw" = "$_sig" ] || continue
        echo "$_d"
        return 0
    done
    echo ""
}

# Never lazy-umount partitions belonging to the live root disk.
safe_umount_disk_parts() {
    _disk=$1
    [ -n "$_disk" ] || return 0
    _root=$(root_disk_name)
    _dname=$(basename "$_disk")
    if [ -n "$_root" ] && [ "$_dname" = "$_root" ]; then
        echo "OS Install: refusing to umount root disk $_disk (only data mounts)"
        return 0
    fi
    umount -l ${_disk}p* 2>/dev/null || true
}

confirm() {
    _msg=$1
    if [ "$YES" -eq 1 ]; then
        return 0
    fi
    echo "** Warning ** $_msg"
    echo "Are you sure you want to proceed? (y/N)"
    read ANSWER
    case "$ANSWER" in
        y|Y|yes|YES|Yes) return 0 ;;
        *)
            echo "Cancelling."
            exit 0
            ;;
    esac
}

stop_services() {
    mkdir -p /run
    touch /run/shutting-down
    echo "OS Install: Stopping Monit"
    monit quit 2>/dev/null || true
    killall monit 2>/dev/null || true
    sleep 1

    echo "OS Install: Stopping running services"
    for i in /var/run/*.pid; do
        [ -f "$i" ] || continue
        kill -15 "$(cat "$i")" 2>/dev/null || true
    done
    killall -15 python 2>/dev/null || true
    sleep 2
}

umount_kubos() {
    echo "OS Install: Unmounting Kubos volumes"
    umount -l /home/microsd 2>/dev/null || true
    umount -l /upgrade 2>/dev/null || true
    umount -l /envar 2>/dev/null || true
    umount -l /home 2>/dev/null || true
    # $1 / $2 are whole disks (/dev/mmcblkN). Never touch root's partitions.
    safe_umount_disk_parts "$1"
    safe_umount_disk_parts "$2"
}

dd_span() {
    _if=$1
    _of=$2
    _count=$3
    _seek=${4:-0}
    _skip=${5:-0}
    _mb=$((_count / 2048))
    echo "OS Install: dd ${_count} sectors (~${_mb} MiB) if=$_if of=$_of skip=$_skip seek=$_seek"
    # Large blocks; avoid pv ($((_count*512)) overflows on 32-bit ash → 0-byte copy).
    # bs=4M (=8192 sectors). Only valid when skip/seek/count are multiples of 8192,
    # or when skip=seek=0 (whole-span install). Otherwise fall back to 512.
    if [ "$_skip" -eq 0 ] && [ "$_seek" -eq 0 ] && [ "$((_count % 8192))" -eq 0 ]; then
        _blk=$((_count / 8192))
        dd if="$_if" of="$_of" bs=4M count="$_blk" conv=fsync
    elif [ "$_skip" -eq 0 ] && [ "$_seek" -eq 0 ]; then
        _blk=$((_count / 8192))
        _rem=$((_count % 8192))
        if [ "$_blk" -gt 0 ]; then
            dd if="$_if" of="$_of" bs=4M count="$_blk" conv=fsync
        fi
        if [ "$_rem" -gt 0 ]; then
            dd if="$_if" of="$_of" bs=512 skip=$((_blk * 8192)) \
                seek=$((_blk * 8192)) count="$_rem" conv=fsync
        fi
    else
        dd if="$_if" of="$_of" bs=512 skip="$_skip" seek="$_seek" \
            count="$_count" conv=fsync
    fi
    sync
}

# MBR disk signature at offset 440. Kubos SD primary uses KLNX (0x4B4C4E58).
# eMMC gets YNLK so PARTUUIDs do not collide while both media are present.
set_disk_signature_emmc() {
    echo "OS Install: Assigning unique eMMC disk signature (YNLK)"
    printf '\131\116\114\113' | dd of="$1" bs=1 seek=440 count=4 conv=notrunc 2>/dev/null
    sync
}

set_disk_signature_sd() {
    # 0x4B4C4E58 ("KLNX") little-endian on disk: 58 4E 4C 4B
    echo "OS Install: Restoring SD primary disk signature (KLNX)"
    printf '\130\116\114\113' | dd of="$1" bs=1 seek=440 count=4 conv=notrunc 2>/dev/null
    sync
}

write_slot_map() {
    _span=$1
    _slots=$2
    _map=/tmp/sd-image-slots.txt
    {
        echo "# SD raw image slots (512-byte sectors). Slot 0 is the live primary."
        echo "# Restore backup N onto primary with:"
        echo "#   dd if=<sd> of=<sd> bs=512 skip=\$((N*SPAN)) count=SPAN"
        echo "span_sectors=$_span"
        _i=0
        while [ "$_i" -lt "$_slots" ]; do
            _off=$((_i * _span))
            if [ "$_i" -eq 0 ]; then
                echo "slot$_i offset=$_off sectors=$_span role=primary"
            else
                echo "slot$_i offset=$_off sectors=$_span role=backup"
            fi
            _i=$((_i + 1))
        done
    } > "$_map"
    echo "OS Install: Slot map written to $_map"
    # Best-effort persist onto /home if it is still mounted or remountable.
    if mount | grep -q ' on /home '; then
        cp "$_map" /home/sd-image-slots.txt 2>/dev/null || true
    fi
}

show_status() {
    need_sd
    SD_NAME=$(basename "$SD")
    SD_BLOCKS=$(cat /sys/block/${SD_NAME}/size)
    SPAN=$(image_span_sectors "$SD_NAME")
    echo "SD:     $SD  (${SD_BLOCKS} sectors, $((SD_BLOCKS / 2048)) MiB)"
    if [ -n "$EMMC" ]; then
        EMMC_NAME=$(basename "$EMMC")
        EMMC_BLOCKS=$(cat /sys/block/${EMMC_NAME}/size)
        EMMC_SPAN=$(image_span_sectors "$EMMC_NAME")
        echo "eMMC:   $EMMC  (${EMMC_BLOCKS} sectors, $((EMMC_BLOCKS / 2048)) MiB)"
        echo "eMMC image span: ${EMMC_SPAN} sectors (~$((EMMC_SPAN / 2048)) MiB)"
    else
        echo "eMMC:   (not present)"
    fi
    echo "SD image span:  ${SPAN} sectors (~$((SPAN / 2048)) MiB)"
    if [ "$SPAN" -le 0 ]; then
        echo "SD backup slots: none (no partitions)"
        return 0
    fi
    SLOTS=$((SD_BLOCKS / SPAN))
    if [ "$SLOTS" -lt 1 ]; then
        SLOTS=1
    fi
    echo "SD backup capacity: ${SLOTS} full image slot(s) (slot0=primary, $((SLOTS - 1)) backup(s))"
    _i=0
    while [ "$_i" -lt "$SLOTS" ]; do
        _off=$((_i * SPAN))
        if [ "$_i" -eq 0 ]; then
            echo "  slot$_i  sectors ${_off}..$((_off + SPAN - 1))  primary"
        else
            echo "  slot$_i  sectors ${_off}..$((_off + SPAN - 1))  backup"
        fi
        _i=$((_i + 1))
    done
    ROOT=$(root_disk_name)
    if [ -n "$ROOT" ]; then
        echo "Currently root on: $ROOT"
    fi
}

create_sd_backups_from() {
    # Clone source image span onto SD slots 1..N-1. Slot 0 left alone unless SRC is foreign.
    _src=$1
    _src_span=$2
    need_sd
    SD_NAME=$(basename "$SD")
    SD_BLOCKS=$(cat /sys/block/${SD_NAME}/size)

    if [ "$_src_span" -le 0 ]; then
        echo "install-os: source image span is empty" >&2
        exit 1
    fi
    if [ "$_src_span" -gt "$SD_BLOCKS" ]; then
        echo "install-os: image span ($_src_span) larger than SD ($SD_BLOCKS)" >&2
        exit 1
    fi

    SLOTS=$((SD_BLOCKS / _src_span))
    if [ "$SLOTS" -lt 2 ]; then
        echo "OS Install: SD does not have enough free space for a backup copy"
        echo "            need >= $((_src_span * 2)) sectors, have $SD_BLOCKS"
        return 0
    fi

    echo "OS Install: Creating $((SLOTS - 1)) SD backup slot(s) (${_src_span} sectors each)"
    _i=1
    while [ "$_i" -lt "$SLOTS" ]; do
        _seek=$((_i * _src_span))
        echo "OS Install: Writing SD backup slot $_i at sector $_seek"
        dd_span "$_src" "$SD" "$_src_span" "$_seek" 0
        _i=$((_i + 1))
    done
    write_slot_map "$_src_span" "$SLOTS"
}

# Sectors to copy for a bootable install: MBR through envar (p3).
# Skip the huge mostly-empty /home (p4); mkfs it on the destination instead.
essential_span_sectors() {
    _disk=$1
    _p3="/sys/block/${_disk}/${_disk}p3"
    if [ -d "$_p3" ]; then
        _s=$(cat "$_p3/start")
        _z=$(cat "$_p3/size")
        echo $((_s + _z))
        return 0
    fi
    image_span_sectors "$_disk"
}

fram_latch_recovery() {
    if [ -x /usr/sbin/fram-set ]; then
        /usr/sbin/fram-set emmc_recovery_needed true 2>/dev/null || true
        echo "OS Install: FRAM emmc_recovery_needed=true (power-cut safe)"
    else
        echo "OS Install: fram-set missing; continuing without FRAM latch" >&2
    fi
}

fram_get_restore_offset() {
    # Returns sector offset (0 if missing/unreadable). Prefer fram-get.
    _off=0
    if [ -x /usr/sbin/fram-get ]; then
        _off=$(/usr/sbin/fram-get emmc_restore_offset 2>/dev/null | awk -F': ' '/intValue:/{print $2; exit}')
    fi
    case "$_off" in
        ''|*[!0-9]*) _off=0 ;;
    esac
    echo "$_off"
}

fram_set_restore_offset() {
    if [ -x /usr/sbin/fram-set ]; then
        /usr/sbin/fram-set emmc_restore_offset "$1" 2>/dev/null || true
    fi
}

fram_clear_recovery_after_verify() {
    if [ -x /usr/sbin/fram-set ]; then
        /usr/sbin/fram-set last_emmc_probe_ok true 2>/dev/null || true
        /usr/sbin/fram-set boot_media 0 2>/dev/null || true
        /usr/sbin/fram-set emmc_restore_offset 0 2>/dev/null || true
        /usr/sbin/fram-set emmc_recovery_needed false 2>/dev/null || true
        echo "OS Install: FRAM recovery latch + restore offset cleared after eMMC verify"
    fi
}

# Chunked SD->eMMC with FRAM emmc_restore_offset checkpoints (8192 sectors = 4MiB).
dd_span_resumable() {
    _if=$1
    _of=$2
    _span=$3
    _pos=$4
    _chunk=8192

    if [ "$_pos" -ge "$_span" ]; then
        echo "OS Install: restore offset $_pos >= span $_span; restarting at 0"
        _pos=0
    fi
    if [ "$_pos" -gt 0 ]; then
        echo "OS Install: resuming at sector $_pos (span $_span)"
    else
        echo "OS Install: starting at sector 0 (span $_span)"
        fram_set_restore_offset 0
    fi

    while [ "$_pos" -lt "$_span" ]; do
        _n=$_chunk
        _rem=$((_span - _pos))
        if [ "$_n" -gt "$_rem" ]; then
            _n=$_rem
        fi
        echo "OS Install: chunk sectors $_pos + $_n"
        dd_span "$_if" "$_of" "$_n" "$_pos" "$_pos"
        _pos=$((_pos + _n))
        fram_set_restore_offset "$_pos"
        sync
    done
}

verify_emmc_bootable() {
    EMMC_NAME=$(basename "$EMMC")
    # Prefer a mounted or temporary mount of eMMC boot (p1) with a kernel file.
    _mp=/tmp/install-os-emmc-boot
    mkdir -p "$_mp"
    umount "$_mp" 2>/dev/null || true
    if mount -t vfat "${EMMC}p1" "$_mp" 2>/dev/null || mount "${EMMC}p1" "$_mp" 2>/dev/null; then
        if [ -f "$_mp/kernel" ] || [ -f "$_mp/uImage" ] || [ -f "$_mp/zImage" ]; then
            umount "$_mp" 2>/dev/null || true
            return 0
        fi
        umount "$_mp" 2>/dev/null || true
    fi
    echo "install-os: eMMC boot partition verify failed (no kernel)" >&2
    return 1
}

do_sd_to_emmc() {
    need_both
    SD_NAME=$(basename "$SD")
    EMMC_NAME=$(basename "$EMMC")
    SPAN=$(essential_span_sectors "$SD_NAME")
    FULL_SPAN=$(image_span_sectors "$SD_NAME")
    EMMC_BLOCKS=$(cat /sys/block/${EMMC_NAME}/size)
    ROOT=$(root_disk_name)

    if [ "$SPAN" -le 0 ]; then
        echo "install-os: no partitions found on $SD" >&2
        exit 1
    fi
    if [ "$SPAN" -gt "$EMMC_BLOCKS" ]; then
        echo "install-os: SD image span ($SPAN) larger than eMMC ($EMMC_BLOCKS)" >&2
        exit 1
    fi
    if [ -n "$ROOT" ] && [ "$ROOT" = "$EMMC_NAME" ]; then
        echo "install-os: rootfs is on eMMC ($EMMC_NAME); refusing SD->eMMC while live on eMMC." >&2
        echo "install-os: boot from SD (root on SD), then re-run: install-os sd-to-emmc" >&2
        exit 1
    fi
    if [ -z "$ROOT" ] || [ "$ROOT" != "$SD_NAME" ]; then
        echo "install-os: rootfs is not on SD ($SD_NAME, root='$ROOT'); refusing." >&2
        echo "install-os: boot from the SD card image, then re-run sd-to-emmc." >&2
        exit 1
    fi

    OFFSET=$(fram_get_restore_offset)
    if [ "$OFFSET" -ge "$SPAN" ]; then
        OFFSET=0
    fi
    confirm "This will wipe eMMC ($EMMC) and copy ${SPAN} sectors (~$((SPAN / 2048)) MiB) from SD ($SD) (resume offset=$OFFSET), then mkfs /home."
    # Latch BEFORE any eMMC write so a power cut mid-copy still boots SD.
    fram_latch_recovery
    stop_services
    umount_kubos "$EMMC" ""
    dd_span_resumable "$SD" "$EMMC" "$SPAN" "$OFFSET"
    sync
    set_disk_signature_emmc "$EMMC"
    sync
    command -v partx >/dev/null 2>&1 && partx -u "$EMMC" 2>/dev/null
    # Partition table still describes p4; format a fresh empty /home.
    if [ -b "${EMMC}p4" ] || [ "$FULL_SPAN" -gt "$SPAN" ]; then
        echo "OS Install: Creating fresh ext4 on ${EMMC}p4 (/home)"
        i=0
        while [ "$i" -lt 10 ] && [ ! -b "${EMMC}p4" ]; do
            sleep 1
            i=$((i + 1))
        done
        if [ -b "${EMMC}p4" ]; then
            mkfs.ext4 -F "${EMMC}p4" || echo "install-os: mkfs ${EMMC}p4 failed (boot anyway, fix /home later)" >&2
        else
            echo "install-os: ${EMMC}p4 not visible yet; reboot into eMMC then mkfs.ext4 ${EMMC}p4 if /home fails" >&2
        fi
    fi
    sync
    if ! verify_emmc_bootable; then
        echo "install-os: leaving emmc_recovery_needed set; reboot will stay on SD" >&2
        exit 1
    fi
    fram_clear_recovery_after_verify
    echo "OS Install: Done (SD -> eMMC)."
    echo "Reboot to eMMC (recovery latch cleared). SD may remain inserted."
}

do_auto_recover() {
    YES=1
    echo "OS Install: auto-recover (FRAM-latched SD->eMMC)"
    do_sd_to_emmc
}

do_emmc_to_sd() {
    need_both
    SD_NAME=$(basename "$SD")
    EMMC_NAME=$(basename "$EMMC")
    SPAN=$(image_span_sectors "$EMMC_NAME")
    SD_BLOCKS=$(cat /sys/block/${SD_NAME}/size)
    ROOT=$(root_disk_name)

    if [ "$SPAN" -le 0 ]; then
        echo "install-os: no partitions found on $EMMC" >&2
        exit 1
    fi
    if [ "$SPAN" -gt "$SD_BLOCKS" ]; then
        echo "install-os: eMMC image span ($SPAN) larger than SD ($SD_BLOCKS)" >&2
        exit 1
    fi

    if [ "$ROOT" = "$SD_NAME" ]; then
        echo "install-os: rootfs is on the SD ($SD_NAME); refusing to overwrite SD primary." >&2
        echo "install-os: boot from eMMC (no SD) or use: install-os sd-backups" >&2
        exit 1
    fi

    _msg="This will wipe SD primary ($SD) and copy ${SPAN} sectors from eMMC ($EMMC)."
    if [ "$DO_BACKUPS" -eq 1 ]; then
        _msg="$_msg Backup slots will also be filled if SD space allows."
    fi
    confirm "$_msg"

    stop_services
    umount_kubos "$SD" "$EMMC"
    dd_span "$EMMC" "$SD" "$SPAN" 0 0
    set_disk_signature_sd "$SD"

    if [ "$DO_BACKUPS" -eq 1 ]; then
        create_sd_backups_from "$EMMC" "$SPAN"
    else
        # Still record that slot0 exists; backups may be added later.
        write_slot_map "$SPAN" 1
    fi

    echo "OS Install: Done (eMMC -> SD)."
    echo "SD primary is a KLNX image; use install-os sd-backups to fill free space."
}

do_sd_backups() {
    need_sd
    SD_NAME=$(basename "$SD")
    SPAN=$(image_span_sectors "$SD_NAME")
    if [ "$SPAN" -le 0 ]; then
        echo "install-os: no partitions found on $SD" >&2
        exit 1
    fi

    confirm "This will write raw backup image copies into free space on $SD (primary slot0 untouched)."
    stop_services
    # Unmount data volumes so /home is quiet; do not need to unmount root.
    umount_kubos "" ""
    # Source is the SD primary itself (skip=0).
    create_sd_backups_from "$SD" "$SPAN"
    echo "OS Install: Done (SD backup slots)."
}

interactive() {
    show_status
    echo
    echo "Select action:"
    echo "  1) SD -> eMMC          (install onboard flash from SD)"
    echo "  2) eMMC -> SD          (refresh SD primary from eMMC)"
    echo "  3) eMMC -> SD+backups  (refresh SD and fill backup slots)"
    echo "  4) SD backups only     (clone SD primary into free SD space)"
    echo "  5) Status only / quit"
    echo -n "Choice [1-5]: "
    read CHOICE
    case "$CHOICE" in
        1) MODE=sd-to-emmc ;;
        2) MODE=emmc-to-sd; DO_BACKUPS=0 ;;
        3) MODE=emmc-to-sd; DO_BACKUPS=1 ;;
        4) MODE=sd-backups ;;
        *) exit 0 ;;
    esac
}

if [ -z "$MODE" ]; then
    interactive
fi

case "$MODE" in
    status)
        show_status
        ;;
    sd-to-emmc)
        do_sd_to_emmc
        ;;
    auto-recover)
        do_auto_recover
        ;;
    emmc-to-sd)
        do_emmc_to_sd
        ;;
    sd-backups)
        do_sd_backups
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

exit 0
