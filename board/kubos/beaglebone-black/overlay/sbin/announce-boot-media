#!/bin/sh
#
# Early userspace banner: which media/partition the rootfs is on.
# SD cards may carry multiple image copies, so the partition number matters.
#
set +e

basename() {
	_b=$1
	_b=${_b%/}
	[ -n "$_b" ] || { echo "/"; return 0; }
	echo "${_b##*/}"
}

# MBR disk signature at offset 440 as little-endian 8 hex digits (PARTUUID prefix).
mbr_sig_le() {
	_raw=$(dd if="$1" bs=1 skip=440 count=4 2>/dev/null | hexdump -v -e '1/1 "%02x"')
	# bytes ABCD on disk (LE) → print DCBA as hex string
	echo "$_raw" | sed -n 's/^\(..\)\(..\)\(..\)\(..\)$/\4\3\2\1/p'
}

root_src=$(awk '$2 == "/" { print $1; exit }' /proc/mounts)
cmdline_root=""
partuuid=""
resolved=""

if [ -r /proc/cmdline ]; then
	cmdline_root=$(sed -n 's/.*root=\([^ ]*\).*/\1/p' /proc/cmdline)
	case "$cmdline_root" in
		PARTUUID=*)
			partuuid=${cmdline_root#PARTUUID=}
			;;
	esac
fi

# Resolve PARTUUID=SSSSSSSS-PP via on-disk MBR signature (BusyBox often has no findfs).
if [ -n "$partuuid" ]; then
	if command -v findfs >/dev/null 2>&1; then
		resolved=$(findfs "PARTUUID=$partuuid" 2>/dev/null)
		[ -n "$resolved" ] && root_src=$resolved
	fi
	if [ -z "$resolved" ] || [ "$root_src" = "/dev/root" ]; then
		sig_hex=$(echo "$partuuid" | sed 's/-.*//' | tr 'A-F' 'a-f')
		part_n=${partuuid#*-}
		part_n=$((0x${part_n}))
		for b in /sys/block/mmcblk*; do
			[ -d "$b" ] || continue
			d=$(basename "$b")
			case "$d" in
				*boot*|*rpmb*) continue ;;
			esac
			raw=$(mbr_sig_le "/dev/$d")
			[ "$raw" = "$sig_hex" ] || continue
			root_src="/dev/${d}p${part_n}"
			break
		done
	fi
fi

if [ -z "$root_src" ] || [ "$root_src" = "/dev/root" ] || [ "$root_src" = "rootfs" ]; then
	echo "Boot media: unknown (root=$cmdline_root)"
	exit 0
fi

name=$(basename "$root_src")
case "$name" in
	mmcblk*p*)
		disk=${name%%p*}
		part=${name#*p}
		;;
	*)
		echo "Boot media: $root_src"
		exit 0
		;;
esac

typ=$(cat "/sys/block/${disk}/device/type" 2>/dev/null || echo unknown)
dev="${disk}p${part}"

case "$typ" in
	SD)
		echo "Boot media: SD card image copy on partition ${part} (${dev})"
		;;
	MMC)
		echo "Boot media: eMMC partition ${part} (${dev})"
		;;
	*)
		echo "Boot media: ${dev} (type=${typ})"
		;;
esac

if [ -n "$partuuid" ]; then
	echo "Boot root PARTUUID=${partuuid}"
fi
exit 0
