#
# Note: BusyBox init doesn't support runlevels.  The runlevels field is
# completely ignored by BusyBox init. If you want runlevels, use
# sysvinit.
#
# Format for each entry: <id>:<runlevels>:<action>:<process>
#
# id        == tty to run on, or empty for /dev/console
# runlevels == ignored
# action    == one of sysinit, respawn, askfirst, wait, and once
# process   == program to run

# Startup the system
::sysinit:/bin/mount -t proc proc /proc
# Hide KERN_NOTICE+ on console (e.g. "random: nonblocking pool is initialized")
::sysinit:/bin/sh -c 'echo 5 >/proc/sys/kernel/printk'
::sysinit:/bin/mkdir -p /dev/pts
::sysinit:/bin/mkdir -p /dev/shm
# Check & clean partitions
::sysinit:/sbin/fsck -p /dev/mmcblk0p1
::sysinit:/sbin/fsck -p /dev/mmcblk0p6
::sysinit:/sbin/fsck -p /dev/mmcblk0p7
::sysinit:/sbin/fsck -p /dev/mmcblk0p8
# Mount up partitions with data
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mount -a
# Setup hostname
::sysinit:/bin/hostname -F /etc/hostname
# now run any rc scripts
::sysinit:/etc/init.d/rcS
# Run Monit in standard run-levels. -I keeps it in the foreground so init
# On reboot, flush-filesystems creates /run/shutting-down first; sleep
# instead of restarting Monit so services are not brought back mid-shutdown.
::respawn:/bin/sh -c 'if [ -e /run/shutting-down ]; then while true; do sleep 3600; done; fi; exec /usr/bin/monit -Ic /etc/monitrc >/dev/null 2>&1'

# Put a getty on the serial port
ttyS0::respawn:/sbin/getty -L  ttyS0 115200 vt100 # GENERIC_SERIAL

# Stuff to do for the 3-finger salute
#::ctrlaltdel:/sbin/reboot

# Stuff to do before rebooting. One bounded script: rcK or umount
# must not be able to sit forever and skip the reboot syscall.
::shutdown:/sbin/flush-filesystems
