From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Radsat Developers <dev@radsat.local>
Date: Wed, 14 Oct 2026 17:05:00 -0600
Subject: [PATCH] ARM: OMAP2+: cold-reset AM33xx without touching the console

Warm reset waits until UART0 goes idle. The console adapter drives
that RX pin, so the reset never finishes while the cable is plugged
in, and the request clears the watchdog. Soft-resetting the UART
from software also drops the console and can stall on that same pin.

Leave the UART alone. After the I2C controllers are off, write
RST_GLOBAL_COLD_SW and wait. That reset does not ask the console
UART to acknowledge idle.

diff --git a/arch/arm/mach-omap2/am33xx-restart.c b/arch/arm/mach-omap2/am33xx-restart.c
index abcd123..abcd124 100644
--- a/arch/arm/mach-omap2/am33xx-restart.c
+++ b/arch/arm/mach-omap2/am33xx-restart.c
@@ -13,6 +13,7 @@
 #include "common.h"
 #include "iomap.h"
 #include "prm.h"
+#include "prm33xx.h"
 
 /*
  * DT node wdt2 / hwmod wd_timer2. This is the TRM WDT1 instance at
@@ -131,21 +132,25 @@
 	}
 }
 
+/* PRM_RSTCTRL bit 1. Does not wait for UART0 to go idle. */
+#define AM33XX_RST_GLOBAL_COLD_SW	(1 << 1)
+
 /**
  * am33xx_restart - trigger a software restart of the SoC
  * @mode: the "reboot mode", see arch/arm/kernel/{setup,process}.c
  * @cmd: passed from the userspace program rebooting the system (if provided)
  *
- * Arm WDT1 first, then turn the I2C controllers off and drop the I2C1
- * and I2C2 clocks without waiting. The warm reset does not finish
- * while a slave controller is still listening, and requesting it
- * clears the watchdog. omap_prm_reset_system() does not return.
+ * Arm WDT1, turn the I2C controllers off, then request a cold reset.
+ * The console UART is left running so the adapter on its RX pin cannot
+ * stall the reset. This write does not return.
  */
 void am33xx_restart(enum reboot_mode mode, const char *cmd)
 {
 	am33xx_arm_wdt();
 	omap_i2c_quiesce_for_restart();
 	am33xx_i2c_clocks_off();
-	pr_emerg("am33xx: forcing warm reset\n");
-	omap_prm_reset_system();
+	pr_emerg("am33xx: forcing cold reset\n");
+	writel_relaxed(AM33XX_RST_GLOBAL_COLD_SW, AM33XX_PRM_RSTCTRL);
+	while (1)
+		cpu_relax();
 }
