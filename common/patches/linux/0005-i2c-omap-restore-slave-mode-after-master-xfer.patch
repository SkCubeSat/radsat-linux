From 9b8df64c92f4fddc0066f4a0440a548da245f6f0 Mon Sep 17 00:00:00 2001
From: Radsat Developers <dev@radsat.local>
Date: Wed, 3 Jun 2026 17:06:00 -0600
Subject: [PATCH] i2c: omap: restore slave mode after master transfers

When an OMAP adapter is also registered as an I2C slave, it must return to
own-address/listen mode after each master transfer. The master path programs
CON with MST set and leaves it there after the bus becomes free. If a remote
master addresses the OBC shortly after the OBC's write, the controller is still
in master mode and does not ACK its slave address.

Reprogram the own-address register, clear MST in CON, and restore interrupt
enables after master transfers and immediately after slave registration.
---
 drivers/i2c/busses/i2c-omap.c | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/drivers/i2c/busses/i2c-omap.c b/drivers/i2c/busses/i2c-omap.c
index 3cf72e3..89c76eb 100644
--- a/drivers/i2c/busses/i2c-omap.c
+++ b/drivers/i2c/busses/i2c-omap.c
@@ -747,6 +747,26 @@ static int omap_i2c_xfer_msg(struct i2c_adapter *adap,
        return -EIO;
 }

+#if OMAP_I2C_SLAVE_ENABLED
+static void omap_i2c_restore_slave_mode(struct omap_i2c_dev *omap)
+{
+       struct i2c_client *slave = omap->slave;
+       u16 con = OMAP_I2C_CON_EN;
+
+       if (!slave)
+               return;
+
+       if (omap->speed > 400)
+               con |= OMAP_I2C_CON_OPMODE_HS;
+       if (slave->flags & I2C_CLIENT_TEN)
+               con |= OMAP_I2C_CON_XOA;
+
+       omap_i2c_write_reg(omap, OMAP_I2C_OA_REG, slave->addr);
+       omap_i2c_write_reg(omap, OMAP_I2C_CON_REG, con);
+       omap_i2c_write_reg(omap, OMAP_I2C_IE_REG, omap->iestate);
+}
+#endif
+

 /*
  * Prepare controller for a transaction and call omap_i2c_xfer_msg
@@ -785,6 +805,10 @@ omap_i2c_xfer(struct i2c_adapter *adap, struct i2c_msg msgs[], int num)

        omap_i2c_wait_for_bb(omap);

+#if OMAP_I2C_SLAVE_ENABLED
+       omap_i2c_restore_slave_mode(omap);
+#endif
+
        if (omap->set_mpu_wkup_lat != NULL)
                omap->set_mpu_wkup_lat(omap->dev, -1);

@@ -1155,6 +1179,7 @@ static int omap_i2c_reg_slave(struct i2c_client *slave)

        omap->iestate |= OMAP_I2C_IE_AAS | OMAP_I2C_IE_BF;
        omap_i2c_write_reg(omap, OMAP_I2C_IE_REG, omap->iestate);
+       omap_i2c_restore_slave_mode(omap);

        spin_unlock_irqrestore(&omap->lock, flags);

--
2.43.0
