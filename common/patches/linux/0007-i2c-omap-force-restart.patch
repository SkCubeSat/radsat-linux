From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Radsat Developers <dev@radsat.local>
Date: Wed, 14 Oct 2026 19:20:00 -0600
Subject: [PATCH] i2c: omap: idle the slave before the AM33xx warm reset

The radios are the other masters on I2C2, so the controller stays in
slave listen. That listen is required. It also never goes idle, and
the warm reset waits for the handshake, then clears the watchdog.
Soft-resetting the controller on a shared bus makes it drive SDA, and
gating its clock without idle sticks the PRCM so the ROM never starts.

Force-idle the listening controller and leave its clock alone. If it
is idle, request the same warm reset the CAN image used. If it is
not, do not request that reset. Arm the watchdog and wait.

diff --git a/arch/arm/mach-omap2/am33xx-restart.c b/arch/arm/mach-omap2/am33xx-restart.c
index abcd123..abcd124 100644
--- a/arch/arm/mach-omap2/am33xx-restart.c
+++ b/arch/arm/mach-omap2/am33xx-restart.c
@@ -103,20 +103,61 @@
 	wdt_wait(base, WWPS_WSPR);
 }
 
+/*
+ * i2c-omap provides the real one. Empty when that driver is not built in,
+ * so a board without CONFIG_I2C_OMAP still links.
+ */
+void __weak omap_i2c_quiesce_for_restart(void)
+{
+}
+
+/* CLKCTRL.IDLEST: 0 functional, 1 transition, 2 idle, 3 disabled. */
+#define AM33XX_CLKCTRL_IDLEST_MASK	(3u << 16)
+
+static int am33xx_i2c_idle(void)
+{
+	void __iomem *clkctrl[] = {
+		AM33XX_CM_PER_I2C1_CLKCTRL,
+		AM33XX_CM_PER_I2C2_CLKCTRL,
+	};
+	unsigned int n, spins;
+	u32 idlest;
+
+	for (n = 0; n < ARRAY_SIZE(clkctrl); n++) {
+		spins = 100000;
+		do {
+			idlest = readl_relaxed(clkctrl[n]);
+			idlest = (idlest & AM33XX_CLKCTRL_IDLEST_MASK) >> 16;
+			if (idlest >= 2)
+				break;
+			cpu_relax();
+		} while (spins--);
+		if (idlest < 2)
+			return 0;
+	}
+	return 1;
+}
+
 /**
  * am33xx_restart - trigger a software restart of the SoC
  * @mode: the "reboot mode", see arch/arm/kernel/{setup,process}.c
  * @cmd: passed from the userspace program rebooting the system (if provided)
  *
- * Warm reset does not finish when a peripheral refuses the PRCM
- * handshake, and device_shutdown() has already stopped the watchdog
- * driver and gated its clock. Arm WDT1 for one second through the
- * static map, then request the warm reset. omap_prm_reset_system()
- * does not return. If that reset hangs, the watchdog resets the chip.
+ * The radios share I2C2, so that controller is left listening as a
+ * slave. A slave never goes idle, and the warm reset waits for that
+ * handshake, then clears the watchdog. Drop slave listen first. If
+ * the controller is idle, request the same warm reset the CAN image
+ * used. If it is not, do not request that reset: arm WDT1 and wait.
  */
 void am33xx_restart(enum reboot_mode mode, const char *cmd)
 {
-	am33xx_arm_wdt();
+	omap_i2c_quiesce_for_restart();
+	if (!am33xx_i2c_idle()) {
+		am33xx_arm_wdt();
+		pr_emerg("am33xx: i2c did not idle\n");
+		while (1)
+			cpu_relax();
+	}
 	pr_emerg("am33xx: warm reset\n");
 	omap_prm_reset_system();
 }
diff --git a/drivers/i2c/busses/i2c-omap.c b/drivers/i2c/busses/i2c-omap.c
index abcd123..abcd124 100644
--- a/drivers/i2c/busses/i2c-omap.c
+++ b/drivers/i2c/busses/i2c-omap.c
@@ -1863,6 +1863,73 @@
 	.recover_bus		= i2c_generic_scl_recovery,
 };
 
+/*
+ * am33xx_restart() calls this with IRQs already off. Slave listen is
+ * how the radios share this bus. Leave the module enabled and it never
+ * idles. Do not soft-reset it: on a shared bus that reset makes BB
+ * invalid and the controller can drive SDA. Force-idle instead.
+ * A suspended controller has its clock off. Do not touch its registers.
+ */
+#define OMAP_I2C_RESTART_MAX	4
+
+static struct omap_i2c_dev *omap_i2c_restart_devs[OMAP_I2C_RESTART_MAX];
+static int omap_i2c_restart_nr;
+
+static void omap_i2c_quiesce_one(struct omap_i2c_dev *omap)
+{
+	u16 sysc;
+
+	if (!omap->base || !omap->regs)
+		return;
+	if (pm_runtime_status_suspended(omap->dev))
+		return;
+
+	if (omap->scheme == OMAP_I2C_SCHEME_0)
+		omap_i2c_write_reg(omap, OMAP_I2C_IE_REG, 0);
+	else
+		omap_i2c_write_reg(omap, OMAP_I2C_IP_V2_IRQENABLE_CLR,
+				   OMAP_I2C_IP_V2_INTERRUPTS_MASK);
+
+	omap_i2c_write_reg(omap, OMAP_I2C_CON_REG, 0);
+	if (omap->rev < OMAP_I2C_OMAP1_REV_2)
+		return;
+
+	sysc = omap_i2c_read_reg(omap, OMAP_I2C_SYSC_REG);
+	sysc &= ~SYSC_SIDLEMODE_MASK;
+	sysc |= SYSC_AUTOIDLE_MASK;
+	omap_i2c_write_reg(omap, OMAP_I2C_SYSC_REG, sysc);
+	omap_i2c_read_reg(omap, OMAP_I2C_CON_REG);
+}
+
+void omap_i2c_quiesce_for_restart(void)
+{
+	int i;
+
+	for (i = 0; i < omap_i2c_restart_nr; i++)
+		omap_i2c_quiesce_one(omap_i2c_restart_devs[i]);
+}
+
+static void omap_i2c_restart_add(struct omap_i2c_dev *omap)
+{
+	if (omap_i2c_restart_nr < OMAP_I2C_RESTART_MAX)
+		omap_i2c_restart_devs[omap_i2c_restart_nr++] = omap;
+}
+
+static void omap_i2c_restart_del(struct omap_i2c_dev *omap)
+{
+	int i;
+
+	for (i = 0; i < omap_i2c_restart_nr; i++) {
+		if (omap_i2c_restart_devs[i] != omap)
+			continue;
+		omap_i2c_restart_devs[i] =
+			omap_i2c_restart_devs[--omap_i2c_restart_nr];
+		omap_i2c_restart_devs[omap_i2c_restart_nr] = NULL;
+		break;
+	}
+}
+
+
 static int
 omap_i2c_probe(struct platform_device *pdev)
 {
@@ -2026,6 +2093,7 @@
 		 major, minor, omap->speed);
 
 	pm_runtime_mark_last_busy(omap->dev);
+	omap_i2c_restart_add(omap);
 	pm_runtime_put_autosuspend(omap->dev);
 
 	return 0;
@@ -2044,6 +2112,7 @@
 	struct omap_i2c_dev	*omap = platform_get_drvdata(pdev);
 	int ret;
 
+	omap_i2c_restart_del(omap);
 	i2c_del_adapter(&omap->adapter);
 	ret = pm_runtime_get_sync(&pdev->dev);
 	if (ret < 0)
diff --git a/drivers/watchdog/omap_wdt.c b/drivers/watchdog/omap_wdt.c
index abcd123..abcd124 100644
--- a/drivers/watchdog/omap_wdt.c
+++ b/drivers/watchdog/omap_wdt.c
@@ -295,6 +295,11 @@
 {
 	struct omap_wdt_dev *wdev = platform_get_drvdata(pdev);
 
+	/* Userspace armed this timer before reboot. Clearing it here is
+	 * what lets a stuck peripheral sit forever.
+	 */
+	if (system_state == SYSTEM_RESTART)
+		return;
 	mutex_lock(&wdev->lock);
 	if (wdev->omap_wdt_users) {
 		omap_wdt_disable(wdev);
