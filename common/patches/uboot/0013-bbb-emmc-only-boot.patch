From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Radsat Developers <dev@radsat.local>
Date: Mon, 2 Nov 2026 21:45:00 -0600
Subject: [PATCH] arm: bbb: eMMC-only boot, init both MMC in SPL

When ROM loads SPL from SD, upstream board_mmc_init only registers
mmc0, so eMMC (mmc1) is invisible and SPL cannot load u-boot.img
from eMMC. Always init both controllers in SPL and boot exclusively
from eMMC (no SD fallback in boot order or distro targets).

---

diff --git a/board/ti/am335x/board.c b/board/ti/am335x/board.c
--- a/board/ti/am335x/board.c
+++ b/board/ti/am335x/board.c
@@ -764,12 +764,22 @@
 
 #ifdef CONFIG_SPL_BUILD
 /*
- * eMMC (mmc1) is the flight default. SD (mmc0) is recovery only.
+ * Flight: eMMC only. ROM may still load SPL from SD if a card is
+ * inserted, but u-boot.img is loaded exclusively from eMMC (mmc1).
+ * Always register both MMC controllers so eMMC is visible even when
+ * the ROM boot device was SD (upstream board_mmc_init only inits
+ * mmc0 in that case).
  */
 void board_boot_order(u32 *spl_boot_list)
 {
 	spl_boot_list[0] = BOOT_DEVICE_MMC2;
-	spl_boot_list[1] = BOOT_DEVICE_MMC1;
+}
+
+int board_mmc_init(bd_t *bis)
+{
+	omap_mmc_init(0, 0, 0, -1, -1);
+	omap_mmc_init(1, 0, 0, -1, -1);
+	return 0;
 }
 #endif
 
diff --git a/include/configs/beaglebone-black.h b/include/configs/beaglebone-black.h
--- a/include/configs/beaglebone-black.h
+++ b/include/configs/beaglebone-black.h
@@ -95,10 +95,9 @@
 #define CONFIG_BOOTCOMMAND \
     "run distro_bootcmd"
 
-/* eMMC (1) default; SD (0) recovery fallback only. */
+/* Flight: eMMC only (no SD boot target). */
 #define BOOT_TARGET_DEVICES(func) \
     func(LEGACY_MMC, legacy_mmc, 1) \
-    func(LEGACY_MMC, legacy_mmc, 0) \
 
 #ifndef CONFIG_SPL_BUILD
 #define CONFIG_EXTRA_ENV_SETTINGS \
