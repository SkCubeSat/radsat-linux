#!/bin/sh
#
# Hardened reboot. Replaces the busybox symlink.
#
# The AM335x warm reset can hang after shutdown has turned the
# watchdog off, and umount can hang before the reboot syscall. Arm
# the hardware watchdog, bound the filesystem flush, then force the
# syscall so inittab cannot block in rcK.
#

echo "reboot: hardened reboot" > /dev/console 2>/dev/null

if [ -x /sbin/flush-filesystems ]; then
    /sbin/flush-filesystems
else
    sync
fi

sync

if [ -x /bin/busybox ]; then
    exec /bin/busybox reboot -f
fi

echo "reboot: /bin/busybox is missing" > /dev/console 2>/dev/null
exit 1
